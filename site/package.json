{
  "name": "primp-site",
  "version": "0.0.0",
  "private": true,
  "description": "The primp website: landing page and docs, a static Next.js export with the real dock running on every page.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "node tools/check-assets.ts && next build && node tools/postbuild.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "geist": "1.9.2",
    "github-slugger": "2.0.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-pretty-code": "0.14.6",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
